#!/bin/bash
# web — browser interaction via cua-driver page tools + Chrome tab control via AppleScript.
# Use for live Chrome pages. Avoid AX tree for web content.
#
# QUICK START:
#   web session                    # show the persistent Pi Automation target
#   web tabs                       # list every Chrome window/tab with bot markers
#   web switch 2                   # switch a tab inside Pi Automation
#   web nav https://example.com    # navigate the persistent bot tab
#   web summary                    # page overview
#   web click-text "Add to cart"   # click by visible text
#
# JS execution is synchronous from the caller's perspective. For network calls inside JS,
# use synchronous XMLHttpRequest (open(..., false)); async fetch promises often return empty.

set -euo pipefail

WEB_CACHE="/tmp/web-chrome-target"
WEB_SESSION_FILE="${WEB_SESSION_FILE:-$HOME/.pi/agent/state/chrome-session.env}"
WEB_SESSION_NAME="${WEB_SESSION_NAME:-Pi Automation}"
PID="${WEB_PID:-}"
WID="${WEB_WID:-}"
TAB_TARGET="${WEB_TAB:-}"
SESSION_WINDOW_ID=""
SESSION_TAB_ID=""
SESSION_TITLE=""
SESSION_URL=""
SESSION_BOUNDS=""
CACHE_SESSION_WINDOW_ID=""
CACHE_SESSION_TAB_ID=""
FAST_SESSION_TARGET=0
SESSION_LOCK_DIR="${WEB_SESSION_FILE}.lock"
SESSION_LOCK_HELD=0

release_session_lock() {
    if [[ "$SESSION_LOCK_HELD" == "1" ]]; then
        rm -rf "$SESSION_LOCK_DIR" 2>/dev/null || true
        SESSION_LOCK_HELD=0
    fi
}

acquire_session_lock() {
    local deadline=$((SECONDS + ${WEB_LOCK_TIMEOUT_SECONDS:-20})) owner=""
    mkdir -p "$(dirname "$WEB_SESSION_FILE")"
    while ! mkdir "$SESSION_LOCK_DIR" 2>/dev/null; do
        if [[ -f "$SESSION_LOCK_DIR/pid" ]]; then owner=$(<"$SESSION_LOCK_DIR/pid"); else owner=""; fi
        if [[ -n "$owner" && "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
            rm -rf "$SESSION_LOCK_DIR" 2>/dev/null || true
            continue
        fi
        if (( SECONDS >= deadline )); then
            echo "Error: timed out waiting for Chrome automation lock: $SESSION_LOCK_DIR" >&2
            return 1
        fi
        sleep 0.05
    done
    printf '%s\n' "$$" > "$SESSION_LOCK_DIR/pid"
    SESSION_LOCK_HELD=1
    trap release_session_lock EXIT INT TERM HUP
}

json_quote() {
    # Pure-bash JSON quoting — avoids ~70ms python3 startup per call
    local input="$1"
    input="${input//\\/\\\\}"
    input="${input//\"/\\\"}"
    input="${input//$'\n'/\\n}"
    input="${input//$'\r'/\\r}"
    input="${input//$'\t'/\\t}"
    printf '"%s"' "$input"
}

load_session() {
    if [[ -f "$WEB_SESSION_FILE" ]]; then
        # This file is written only by this script and contains numeric Chrome IDs.
        # shellcheck disable=SC1090
        source "$WEB_SESSION_FILE" 2>/dev/null || true
        SESSION_WINDOW_ID="${CHROME_WINDOW_ID:-}"
        SESSION_TAB_ID="${CHROME_TAB_ID:-}"
    fi
}

save_session() {
    mkdir -p "$(dirname "$WEB_SESSION_FILE")"
    [[ "$SESSION_WINDOW_ID" =~ ^[0-9]+$ ]] || return 1
    [[ "$SESSION_TAB_ID" =~ ^[0-9]+$ ]] || return 1
    {
        printf 'CHROME_WINDOW_ID=%s\n' "$SESSION_WINDOW_ID"
        printf 'CHROME_TAB_ID=%s\n' "$SESSION_TAB_ID"
    } > "$WEB_SESSION_FILE"
}

parse_session_record() {
    local record="$1" x1 y1 x2 y2
    IFS=$'\t' read -r SESSION_WINDOW_ID SESSION_TAB_ID x1 y1 x2 y2 SESSION_TITLE SESSION_URL <<< "$record"
    SESSION_BOUNDS="$x1,$y1,$((x2-x1)),$((y2-y1))"
    [[ "$SESSION_WINDOW_ID" =~ ^[0-9]+$ && "$SESSION_TAB_ID" =~ ^[0-9]+$ ]]
}

resolve_session_record() {
    local wanted_window="$1" wanted_tab="$2"
    osascript - "$wanted_window" "$wanted_tab" "$WEB_SESSION_NAME" <<'APPLESCRIPT'
on run argv
  set wantedWindow to item 1 of argv
  set wantedTab to item 2 of argv
  set sessionName to item 3 of argv
  set d to ASCII character 9
  tell application "Google Chrome"
    set targetWindow to missing value
    if wantedWindow is not "" then
      repeat with w in windows
        if (id of w as text) is wantedWindow then
          try
            if (given name of w as text) is sessionName then set targetWindow to w
          end try
          if targetWindow is not missing value then exit repeat
        end if
      end repeat
    end if
    if targetWindow is missing value then
      repeat with w in windows
        try
          if (given name of w as text) is sessionName then
            set targetWindow to w
            exit repeat
          end if
        end try
      end repeat
    end if
    if targetWindow is missing value then error "Pi Automation Chrome window is missing"

    set targetTab to missing value
    if wantedTab is not "" then
      repeat with t in tabs of targetWindow
        if (id of t as text) is wantedTab then
          set targetTab to t
          exit repeat
        end if
      end repeat
    end if
    if targetTab is missing value then set targetTab to active tab of targetWindow
    -- cua-driver's page primitive addresses the active tab of an exact native
    -- window. Keep the remembered bot tab active inside the dedicated bot
    -- window without raising that window or changing the user's foreground.
    set tabIndex to 0
    repeat with candidate in tabs of targetWindow
      set tabIndex to tabIndex + 1
      if (id of candidate as text) is (id of targetTab as text) then
        set active tab index of targetWindow to tabIndex
        exit repeat
      end if
    end repeat
    set b to bounds of targetWindow
    return (id of targetWindow as text) & d & (id of targetTab as text) & d & (item 1 of b as text) & d & (item 2 of b as text) & d & (item 3 of b as text) & d & (item 4 of b as text) & d & (title of targetTab as text) & d & (URL of targetTab as text)
  end tell
end run
APPLESCRIPT
}

create_session_record() {
    osascript - "$WEB_SESSION_NAME" <<'APPLESCRIPT'
on run argv
  set sessionName to item 1 of argv
  set d to ASCII character 9
  tell application "Google Chrome"
    set targetWindow to make new window
    set given name of targetWindow to sessionName
    set targetTab to active tab of targetWindow
    set b to bounds of targetWindow
    return (id of targetWindow as text) & d & (id of targetTab as text) & d & (item 1 of b as text) & d & (item 2 of b as text) & d & (item 3 of b as text) & d & (item 4 of b as text) & d & (title of targetTab as text) & d & (URL of targetTab as text)
  end tell
end run
APPLESCRIPT
}

ensure_session() {
    local record
    load_session
    if record=$(resolve_session_record "$SESSION_WINDOW_ID" "$SESSION_TAB_ID" 2>/dev/null) && parse_session_record "$record"; then
        save_session
        return 0
    fi

    # Never fall back to the user's front Chrome window. If the persistent bot
    # window was closed, create a clearly named window in the same Chrome profile,
    # then restore the user's exact foreground app/window/tab.
    capture_ui_context
    record=$(create_session_record 2>/dev/null) || {
        open -g -b com.google.Chrome --args --new-window >/dev/null 2>&1 || true
        sleep 0.3
        record=$(create_session_record)
    }
    parse_session_record "$record"
    save_session
    restore_ui_context
}

cmd_session() {
    ensure_session
    printf '{"name":%s,"windowId":%s,"tabId":%s,"target":"tab:%s","bounds":%s,"title":%s,"url":%s}\n' \
        "$(json_quote "$WEB_SESSION_NAME")" "$SESSION_WINDOW_ID" "$SESSION_TAB_ID" "$SESSION_TAB_ID" \
        "$(json_quote "$SESSION_BOUNDS")" "$(json_quote "$SESSION_TITLE")" "$(json_quote "$SESSION_URL")"
}

UI_FRONT_APP=""
UI_CHROME_WINDOW_ID=""
UI_CHROME_TAB_ID=""

capture_ui_context() {
    local record
    record=$(osascript <<'APPLESCRIPT'
set d to ASCII character 9
set frontApp to ""
tell application "System Events"
  try
    set frontApp to name of first application process whose frontmost is true
  end try
end tell
set chromeWindow to ""
set chromeTab to ""
tell application "Google Chrome"
  if (count of windows) > 0 then
    set chromeWindow to id of window 1 as text
    set chromeTab to id of active tab of window 1 as text
  end if
end tell
return frontApp & d & chromeWindow & d & chromeTab
APPLESCRIPT
) || true
    IFS=$'\t' read -r UI_FRONT_APP UI_CHROME_WINDOW_ID UI_CHROME_TAB_ID <<< "$record"
}

restore_ui_context() {
    osascript - "$UI_FRONT_APP" "$UI_CHROME_WINDOW_ID" "$UI_CHROME_TAB_ID" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
  set frontApp to item 1 of argv
  set wantedWindow to item 2 of argv
  set wantedTab to item 3 of argv
  tell application "Google Chrome"
    repeat with w in windows
      if (id of w as text) is wantedWindow then
        repeat with t in tabs of w
          if (id of t as text) is wantedTab then
            set tabIndex to 0
            repeat with candidate in tabs of w
              set tabIndex to tabIndex + 1
              if (id of candidate as text) is wantedTab then exit repeat
            end repeat
            set active tab index of w to tabIndex
            exit repeat
          end if
        end repeat
        set index of w to 1
        exit repeat
      end if
    end repeat
  end tell
  if frontApp is not "" then
    tell application "System Events"
      try
        set frontmost of first application process whose name is frontApp to true
      end try
    end tell
  end if
end run
APPLESCRIPT
}

load_cache() {
    if [[ -f "$WEB_CACHE" ]]; then
        # This file is generated only by this script and contains numeric IDs.
        # shellcheck disable=SC1090
        source "$WEB_CACHE" 2>/dev/null || true
        PID="${PID:-${WEB_PID:-}}"
        WID="${WID:-${WEB_WID:-}}"
        CACHE_SESSION_WINDOW_ID="${WEB_CHROME_WINDOW_ID:-}"
        CACHE_SESSION_TAB_ID="${WEB_CHROME_TAB_ID:-}"
    fi
}

write_cache_line() {
    local pid="$1" wid="$2" chrome_window_id="${3:-}" chrome_tab_id="${4:-}"
    printf 'WEB_PID=%s; export WEB_PID; WEB_WID=%s; export WEB_WID; WEB_CHROME_WINDOW_ID=%s; export WEB_CHROME_WINDOW_ID; WEB_CHROME_TAB_ID=%s; export WEB_CHROME_TAB_ID\n' \
        "$pid" "$wid" "$chrome_window_id" "$chrome_tab_id"
}

# Load cached target immediately, but CLI --pid/--wid can override below.
load_cache

POSITIONAL=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --pid)   PID="${2:?Missing value for --pid}"; shift 2 ;;
        --wid)   WID="${2:?Missing value for --wid}"; shift 2 ;;
        --pid=*) PID="${1#--pid=}"; shift ;;
        --wid=*) WID="${1#--wid=}"; shift ;;
        --tab)   TAB_TARGET="${2:?Missing value for --tab}"; shift 2 ;;
        --tab=*) TAB_TARGET="${1#--tab=}"; shift ;;
        *)       POSITIONAL+=("$1"); shift ;;
    esac
done
set -- "${POSITIONAL[@]}"

cache_native_session_target() {
    # Resolve only the dedicated Pi Automation window. This is the slow repair /
    # bootstrap path; normal page commands reuse the resulting native pid/window
    # IDs and go straight through the persistent cua-driver daemon.
    local result
    result=$(cua-driver call list_windows '{"on_screen_only":false}' --compact 2>&1) || {
        printf '%s\n' "$result" >&2
        return 1
    }
    printf '%s' "$result" | python3 -c '
import json, sys
cache, bounds, chrome_window_id, chrome_tab_id = sys.argv[1:5]
x, y, width, height = map(int, bounds.split(","))
try:
    data = json.load(sys.stdin)
    wins = [w for w in data.get("windows", []) if w.get("app_name") == "Google Chrome"]
    named = [w for w in wins if w.get("title") == "Pi Automation"]
    bounded = [w for w in wins if all(abs(int((w.get("bounds") or {}).get(k, -99999)) - v) <= 3 for k, v in (("x",x),("y",y),("width",width),("height",height)))]
    matched = named or bounded
    if not matched:
        raise SystemExit(1)
    matched.sort(key=lambda w: (bool(w.get("is_on_screen")), w.get("on_current_space") is not False, w.get("z_index", -9999)), reverse=True)
    w = matched[0]
    line = "WEB_PID={}; export WEB_PID; WEB_WID={}; export WEB_WID; WEB_CHROME_WINDOW_ID={}; export WEB_CHROME_WINDOW_ID; WEB_CHROME_TAB_ID={}; export WEB_CHROME_TAB_ID".format(w["pid"], w["window_id"], chrome_window_id, chrome_tab_id)
    print(line)
    with open(cache, "w") as f:
        f.write(line + "\n")
except Exception:
    raise SystemExit(1)
' "$WEB_CACHE" "$SESSION_BOUNDS" "$SESSION_WINDOW_ID" "$SESSION_TAB_ID"
}

try_cached_session_target() {
    load_session
    load_cache
    if [[ "$SESSION_WINDOW_ID" =~ ^[0-9]+$ && "$SESSION_TAB_ID" =~ ^[0-9]+$ &&
          "$PID" =~ ^[0-9]+$ && "$WID" =~ ^[0-9]+$ &&
          "$CACHE_SESSION_WINDOW_ID" == "$SESSION_WINDOW_ID" &&
          "$CACHE_SESSION_TAB_ID" == "$SESSION_TAB_ID" ]]; then
        FAST_SESSION_TARGET=1
        TAB_TARGET=""
        return 0
    fi
    return 1
}

refresh_fast_session_target() {
    ensure_session || return 1
    cache_native_session_target >/dev/null || return 1
    PID=""
    WID=""
    CACHE_SESSION_WINDOW_ID=""
    CACHE_SESSION_TAB_ID=""
    unset WEB_PID WEB_WID WEB_CHROME_WINDOW_ID WEB_CHROME_TAB_ID 2>/dev/null || true
    load_cache
    if [[ "$PID" =~ ^[0-9]+$ && "$WID" =~ ^[0-9]+$ &&
          "$CACHE_SESSION_WINDOW_ID" == "$SESSION_WINDOW_ID" &&
          "$CACHE_SESSION_TAB_ID" == "$SESSION_TAB_ID" ]]; then
        FAST_SESSION_TARGET=1
        TAB_TARGET=""
        return 0
    fi
    return 1
}

cmd_auto() {
    ensure_session
    cache_native_session_target
}

ensure_target() {
    # No --tab means the persistent Pi Automation tab—not whichever Chrome
    # window happens to be frontmost this turn. Reuse its exact cached native
    # window through cua-driver; only bootstrap/repair pays the AppleScript tab
    # discovery cost. "active" remains an explicit opt-in to the user's tab.
    if [[ -z "$TAB_TARGET" || "$TAB_TARGET" == "session" || "$TAB_TARGET" == "bot" ]]; then
        if try_cached_session_target; then return 0; fi
        if refresh_fast_session_target; then return 0; fi
        # Safe fallback: exact-tab Apple Events, never the user's front window.
        ensure_session
        TAB_TARGET="tab:$SESSION_TAB_ID"
        return 0
    fi

    # Explicit tab IDs, active, indices, URLs, and titles are driven directly
    # through Chrome Apple Events without activating or switching windows.
    if [[ -n "$TAB_TARGET" ]]; then
        return 0
    fi

    # Retained only for explicit legacy WEB_PID/WEB_WID callers.
    if [[ -n "$PID" && -n "$WID" ]]; then return 0; fi
    echo "Error: No Chrome target." >&2
    exit 1
}

run_js_in_tab() {
    local target="$1" js="$2"
    osascript - "$target" "$js" "$WEB_SESSION_NAME" <<'APPLESCRIPT'
on run argv
  set needle to item 1 of argv
  set sourceCode to item 2 of argv
  set sessionName to item 3 of argv
  tell application "Google Chrome"
    set targetTab to missing value
    set sessionWindow to missing value
    repeat with w in windows
      try
        if (given name of w as text) is sessionName then
          set sessionWindow to w
          exit repeat
        end if
      end try
    end repeat

    if needle starts with "tab:" then
      set wantedId to text 5 thru -1 of needle
      repeat with w in windows
        repeat with t in tabs of w
          if (id of t as text) is wantedId then
            set targetTab to t
            exit repeat
          end if
        end repeat
        if targetTab is not missing value then exit repeat
      end repeat
    else if needle starts with "window:" then
      set wantedId to text 8 thru -1 of needle
      repeat with w in windows
        if (id of w as text) is wantedId then
          set targetTab to active tab of w
          exit repeat
        end if
      end repeat
    else if needle is "session" or needle is "bot" then
      if sessionWindow is not missing value then set targetTab to active tab of sessionWindow
    else if needle is "active" or needle is "__active__" then
      if (count of windows) > 0 then set targetTab to active tab of window 1
    else
      try
        set tabIndex to needle as integer
        if sessionWindow is not missing value then
          if tabIndex ≥ 1 and tabIndex ≤ (count of tabs of sessionWindow) then set targetTab to tab tabIndex of sessionWindow
        else if tabIndex ≥ 1 and tabIndex ≤ (count of tabs of window 1) then
          set targetTab to tab tabIndex of window 1
        end if
      end try
    end if

    -- Named searches prefer the persistent bot window, then search all Chrome windows.
    if targetTab is missing value and sessionWindow is not missing value then
      repeat with t in tabs of sessionWindow
        if (URL of t contains needle) or (title of t contains needle) then
          set targetTab to t
          exit repeat
        end if
      end repeat
    end if
    if targetTab is missing value then
      repeat with w in windows
        repeat with t in tabs of w
          if (URL of t contains needle) or (title of t contains needle) then
            set targetTab to t
            exit repeat
          end if
        end repeat
        if targetTab is not missing value then exit repeat
      end repeat
    end if
    if targetTab is missing value then error "No Chrome tab matches: " & needle
    return execute targetTab javascript sourceCode
  end tell
end run
APPLESCRIPT
}

unwrap_cua_page_result() {
    local text="$1" open_fence=$'```\n' close_fence=$'\n```'
    if [[ "$text" == "## Result"$'\n\n'* && "$text" == *"$close_fence" ]]; then
        text="${text#*"$open_fence"}"
        text="${text%"$close_fence"}"
    fi
    printf '%s' "$text"
}

run_js() {
    local js="$1" quoted_js payload out i
    if [[ -n "$TAB_TARGET" ]]; then
        local retries="${WEB_RUN_RETRIES:-3}" rc=0
        i=0
        while (( i < retries )); do
            if out=$(run_js_in_tab "$TAB_TARGET" "$js" 2>&1); then rc=0; else rc=$?; fi
            if (( rc == 0 )) && ! printf '%s' "$out" | grep -Eq 'missing value|execution error|Can.?t get|Invalid index|No Chrome tab matches'; then
                printf '%s' "$out"
                return 0
            fi
            (( i++ )) || true
            sleep 0.15
        done
        if printf '%s' "$out" | grep -q 'missing value'; then
            printf 'web run: JS returned "missing value" after %s attempt(s) — the page may still be navigating or the JS returned undefined.\n' "$retries" >&2
        else
            printf '%s\n' "$out" >&2
        fi
        return 1
    fi

    # Fast path: the dedicated automation window is already bound to the
    # long-running cua-driver daemon. This avoids an osascript process and a
    # full Chrome window/tab scan for every DOM command.
    local retries="${WEB_RUN_RETRIES:-3}" rc=0 repaired=0
    i=0
    while (( i < retries )); do
        quoted_js=$(json_quote "$js")
        payload=$(printf '{"pid":%s,"window_id":%s,"action":"execute_javascript","javascript":%s}\n' "$PID" "$WID" "$quoted_js")
        if out=$(printf '%s' "$payload" | cua-driver call page --compact 2>&1); then rc=0; else rc=$?; fi

        if (( rc != 0 && FAST_SESSION_TARGET == 1 && repaired == 0 )) &&
           printf '%s' "$out" | grep -Eqi 'No window|window_id|does not exist|connection refused|daemon|target.*not found'; then
            repaired=1
            if refresh_fast_session_target; then continue; fi
        fi

        if (( rc == 0 )) && ! printf '%s' "$out" | grep -q 'missing value'; then
            unwrap_cua_page_result "$out"
            return 0
        fi
        (( i++ )) || true
        sleep 0.15
    done

    if printf '%s' "$out" | grep -q 'missing value'; then
        printf 'web run: JS returned "missing value" after %s attempt(s) — likely a timeout or undefined result. Return a serializable value or fetch less per call.\n' "$retries" >&2
    else
        printf '%s\n' "$out" >&2
    fi
    return 1
}

# --- Page commands ---

run_action_js() {
    local out rc=0
    if out=$(run_js "$1" 2>&1); then rc=0; else rc=$?; fi
    printf '%s\n' "$out"
    (( rc == 0 )) || return "$rc"
    if printf '%s' "$out" | grep -Eq '(^|[,{])[[:space:]]*"error"[[:space:]]*:'; then return 1; fi
}

cmd_nav() {
    local url="${1:?Usage: web nav <url>}"
    local url_q
    url_q=$(json_quote "$url")
    run_js "location.href=$url_q"
    echo "Navigated current tab to: $url"
    echo "(Use 'web newtab <url>' to open in a new tab instead.)"
}

cmd_text() {
    if [[ -n "$TAB_TARGET" ]]; then
        run_js "document.body ? document.body.innerText : ''"
    else
        cua-driver call page "{\"pid\":$PID,\"window_id\":$WID,\"action\":\"get_text\"}" --compact 2>&1
    fi
}

cmd_summary() {
    run_js "(()=>{const visible=e=>!!(e.offsetWidth||e.offsetHeight||e.getClientRects().length);const label=e=>(e.innerText||e.value||e.getAttribute('aria-label')||e.title||e.placeholder||'').trim();const h=Array.from(document.querySelectorAll('h1,h2,h3')).filter(visible).map(e=>label(e).slice(0,80)).filter(Boolean).slice(0,10);const b=Array.from(document.querySelectorAll('button,input[type=submit],input[type=button],[role=button]')).filter(visible).map(e=>({text:label(e).slice(0,60),disabled:!!e.disabled,id:e.id||''})).slice(0,20);const l=Array.from(document.querySelectorAll('a[href]')).filter(a=>visible(a)&&label(a)).map(a=>({text:label(a).slice(0,60),href:a.href})).slice(0,25);const f=Array.from(document.querySelectorAll('input,textarea,select')).filter(e=>visible(e)&&e.type!=='hidden').map(e=>({tag:e.tagName,type:e.type||'',name:e.name||e.id||'',placeholder:e.placeholder||'',value:(e.value||'').slice(0,40)})).slice(0,15);return JSON.stringify({url:location.href,title:document.title,headings:h,buttons:b,links:l,forms:f,scroll:Math.round(window.scrollY),ready:document.readyState})})()"
}

cmd_url() { run_js "location.href"; }
cmd_title() { run_js "document.title"; }

cmd_find() {
    local selector_q
    selector_q=$(json_quote "${1:?Usage: web find <selector>}")
    run_js "(()=>{const selector=$selector_q;const visible=e=>!!(e.offsetWidth||e.offsetHeight||e.getClientRects().length);return JSON.stringify(Array.from(document.querySelectorAll(selector)).filter(visible).map((e,i)=>({i,tag:e.tagName,text:(e.innerText||e.value||'').trim().slice(0,100),href:e.href||'',id:e.id||'',cls:(e.className||'').toString().slice(0,80),type:e.type||'',name:e.name||'',placeholder:e.placeholder||''})))})()"
}

cmd_find_text() {
    local text_q selector_q
    text_q=$(json_quote "${1:?Usage: web find-text <text>}")
    selector_q=$(json_quote "${2:-a,button,input,select,textarea,[role],label,[onclick]}")
    run_js "(()=>{const needle=$text_q;const selector=$selector_q;const visible=e=>!!(e.offsetWidth||e.offsetHeight||e.getClientRects().length);const txt=e=>(e.innerText||e.value||e.getAttribute('aria-label')||e.title||e.placeholder||'');const norm=s=>String(s||'').replace(/\\s+/g,' ').trim().toLowerCase();const q=norm(needle);const interactive=e=>/^(A|BUTTON|INPUT|SELECT|TEXTAREA|MAT-OPTION)$/.test(e.tagName)||['button','option','menuitem','radio','checkbox','link','tab'].includes(e.getAttribute('role'));const depth=e=>{let d=0;for(let n=e;n;n=n.parentElement)d++;return d};const rows=Array.from(document.querySelectorAll(selector)).filter(e=>visible(e)&&norm(txt(e)).includes(q)).map((e,order)=>{const n=norm(txt(e));const score=(n===q?100000:n.startsWith(q)?50000:10000)+(interactive(e)?2000:0)+depth(e)*5-Math.min(n.length,1000);return{e,order,score}}).sort((a,b)=>b.score-a.score||a.order-b.order).map(({e},i)=>({i,tag:e.tagName,text:txt(e).trim().slice(0,100),href:e.href||'',id:e.id||'',cls:(e.className||'').toString().slice(0,80),type:e.type||'',name:e.name||'',placeholder:e.placeholder||''}));return JSON.stringify(rows)})()"
}

cmd_find_links() {
    local text_q
    text_q=$(json_quote "${1:-}")
    run_js "(()=>{const needle=$text_q;const visible=e=>!!(e.offsetWidth||e.offsetHeight||e.getClientRects().length);return JSON.stringify(Array.from(document.querySelectorAll('a[href]')).filter(a=>visible(a)&&(a.innerText||'').trim()&&(!needle||(a.innerText||'').toLowerCase().includes(needle.toLowerCase()))).map((a,i)=>({i,text:a.innerText.trim().slice(0,100),href:a.href})).slice(0,80))})()"
}

cmd_find_buttons() {
    local text_q
    text_q=$(json_quote "${1:-}")
    run_js "(()=>{const needle=$text_q;const visible=e=>!!(e.offsetWidth||e.offsetHeight||e.getClientRects().length);const txt=e=>(e.innerText||e.value||e.getAttribute('aria-label')||e.title||'');return JSON.stringify(Array.from(document.querySelectorAll('button,input[type=submit],input[type=button],[role=button]')).filter(b=>visible(b)&&(!needle||txt(b).toLowerCase().includes(needle.toLowerCase()))).map((b,i)=>({i,text:txt(b).trim().slice(0,80),id:b.id||'',cls:(b.className||'').toString().slice(0,80),type:b.type||'',disabled:!!b.disabled})).slice(0,80))})()"
}

cmd_find_inputs() {
    run_js "(()=>{const visible=e=>!!(e.offsetWidth||e.offsetHeight||e.getClientRects().length);return JSON.stringify(Array.from(document.querySelectorAll('input,textarea,select')).filter(e=>visible(e)&&e.type!=='hidden').map((e,i)=>({i,tag:e.tagName,type:e.type||'',name:e.name||'',id:e.id||'',value:(e.value||'').slice(0,80),placeholder:e.placeholder||'',label:(e.labels&&e.labels[0]?e.labels[0].innerText.trim().slice(0,80):''),required:!!e.required})).slice(0,100))})()"
}

cmd_click() {
    local selector_q
    selector_q=$(json_quote "${1:?Usage: web click <selector>}")
    run_action_js "(()=>{const selector=$selector_q;const e=document.querySelector(selector);if(!e)return JSON.stringify({error:'Element not found',selector});if(e.disabled||e.getAttribute('aria-disabled')==='true')return JSON.stringify({error:'Element is disabled',selector});e.scrollIntoView({block:'center',inline:'center'});e.focus({preventScroll:true});e.click();return JSON.stringify({clicked:true,synthetic:true,tag:e.tagName,text:(e.innerText||e.value||e.getAttribute('aria-label')||'').trim().slice(0,80)})})()"
}

cmd_click_text() {
    local text_q selector_q
    text_q=$(json_quote "${1:?Usage: web click-text <text>}")
    selector_q=$(json_quote "${2:-a,button,input,select,textarea,[role],label,[onclick]}")
    run_action_js "(()=>{const needle=$text_q;const selector=$selector_q;const visible=e=>!!(e.offsetWidth||e.offsetHeight||e.getClientRects().length);const txt=e=>(e.innerText||e.value||e.getAttribute('aria-label')||e.title||e.placeholder||'');const norm=s=>String(s||'').replace(/\\s+/g,' ').trim().toLowerCase();const q=norm(needle);const interactive=e=>/^(A|BUTTON|INPUT|SELECT|TEXTAREA|MAT-OPTION)$/.test(e.tagName)||['button','option','menuitem','radio','checkbox','link','tab'].includes(e.getAttribute('role'));const depth=e=>{let d=0;for(let n=e;n;n=n.parentElement)d++;return d};const candidates=Array.from(document.querySelectorAll(selector)).filter(e=>visible(e)&&norm(txt(e)).includes(q)).map((e,order)=>{const n=norm(txt(e));return{e,order,score:(n===q?100000:n.startsWith(q)?50000:10000)+(interactive(e)?2000:0)+depth(e)*5-Math.min(n.length,1000)}}).sort((a,b)=>b.score-a.score||a.order-b.order);const found=candidates[0]?.e;if(!found)return JSON.stringify({error:'No element found with text',text:needle});if(found.disabled||found.getAttribute('aria-disabled')==='true')return JSON.stringify({error:'Element is disabled',text:needle,tag:found.tagName});found.scrollIntoView({block:'center',inline:'center'});found.focus({preventScroll:true});found.click();return JSON.stringify({clicked:true,synthetic:true,tag:found.tagName,text:txt(found).trim().slice(0,80),href:found.href||'',exact:Math.abs((candidates[0]?.score||0))>=100000})})()"
}

run_main_js() {
    local source="${1:?Usage: web run-main <js>}" source_q
    source_q=$(json_quote "$source")
    run_action_js "(()=>{const source=$source_q;const id='__web_main_'+Date.now()+'_'+Math.random().toString(36).slice(2);const carrier=document.createElement('div');carrier.id=id;carrier.hidden=true;document.documentElement.appendChild(carrier);const script=document.createElement('script');script.textContent='(()=>{const carrier=document.getElementById('+JSON.stringify(id)+');try{const value=(0,eval)('+JSON.stringify(source)+');if(value===undefined)carrier.textContent=JSON.stringify({mainWorld:true,value:null});else if(typeof value===\"string\")carrier.textContent=value;else carrier.textContent=JSON.stringify(value);}catch(e){carrier.textContent=JSON.stringify({error:\"Main-world JavaScript failed\",message:String(e&&e.message||e),stack:String(e&&e.stack||\"\").slice(0,1000)});}})()';(document.head||document.documentElement).appendChild(script);script.remove();const out=carrier.textContent;carrier.remove();return out||JSON.stringify({error:'Main-world script did not execute; the page Content Security Policy may block inline injection.'})})()"
}

cmd_fill() {
    local selector_q value_q main_source main_out
    selector_q=$(json_quote "${1:?Usage: web fill <selector> <value>}")
    value_q=$(json_quote "${2:?Usage: web fill <selector> <value>}")
    main_source="(()=>{const selector=$selector_q;const value=$value_q;const e=document.querySelector(selector);if(!e)return {error:'Element not found',selector};if(e.disabled||e.getAttribute('aria-disabled')==='true')return {error:'Element is disabled',selector};e.scrollIntoView({block:'center',inline:'center'});e.focus({preventScroll:true});const jq=window.jQuery;const wrapper=e.closest&&e.closest('.custom-combobox');const linked=wrapper&&wrapper.previousElementSibling;if(jq&&linked&&linked.tagName==='SELECT'&&typeof jq(linked).combobox==='function'){if(!Array.from(linked.options).some(o=>o.value===value||o.text===value))linked.add(new Option(value,value));linked.value=value;jq(linked).combobox('setValueChange',value);e.blur();return {filled:true,tag:e.tagName,value:e.value,framework:'jquery-ui-combobox',mainWorld:true}}if(e.tagName.toLowerCase()==='select'){e.value=value;e.dispatchEvent(new Event('input',{bubbles:true}));e.dispatchEvent(new Event('change',{bubbles:true}));e.blur();return {filled:true,tag:'SELECT',value:e.value,mainWorld:true}}let proto=e,desc;while(proto&&!desc){proto=Object.getPrototypeOf(proto);if(proto)desc=Object.getOwnPropertyDescriptor(proto,'value')}if(desc&&desc.set)desc.set.call(e,value);else e.value=value;e.dispatchEvent(new InputEvent('input',{bubbles:true,inputType:'insertText',data:value}));e.dispatchEvent(new Event('change',{bubbles:true}));e.blur();return {filled:true,tag:e.tagName,value:(e.value||'').slice(0,100),mainWorld:true}})()"
    # Prefer the page's own JavaScript world so jQuery/React/Vue-owned state is
    # updated without bringing Chrome forward. Strict CSP pages fall back to the
    # older isolated-world setter below.
    if main_out=$(run_main_js "$main_source" 2>/dev/null); then
        printf '%s\n' "$main_out"
        return 0
    fi
    run_action_js "(()=>{const selector=$selector_q;const value=$value_q;const e=document.querySelector(selector);if(!e)return JSON.stringify({error:'Element not found',selector});if(e.disabled||e.getAttribute('aria-disabled')==='true')return JSON.stringify({error:'Element is disabled',selector});e.scrollIntoView({block:'center',inline:'center'});e.focus();if(e.tagName.toLowerCase()==='select'){e.value=value;e.dispatchEvent(new Event('input',{bubbles:true}));e.dispatchEvent(new Event('change',{bubbles:true}));return JSON.stringify({filled:true,tag:'SELECT',value:e.value,fallback:'isolated-world'})}let proto=e,desc;while(proto&&!desc){proto=Object.getPrototypeOf(proto);if(proto)desc=Object.getOwnPropertyDescriptor(proto,'value')}if(desc&&desc.set)desc.set.call(e,value);else e.value=value;e.dispatchEvent(new InputEvent('input',{bubbles:true,inputType:'insertText',data:value}));e.dispatchEvent(new Event('change',{bubbles:true}));return JSON.stringify({filled:true,tag:e.tagName,value:(e.value||'').slice(0,100),fallback:'isolated-world'})})()"
}

cmd_select() {
    local selector_q option_q
    selector_q=$(json_quote "${1:?Usage: web select <selector> <option-text>}")
    option_q=$(json_quote "${2:?Usage: web select <selector> <option-text>}")
    run_action_js "(()=>{const selector=$selector_q;const needle=$option_q;const s=document.querySelector(selector);if(!s||s.tagName!=='SELECT')return JSON.stringify({error:'Select not found',selector});const q=needle.toLowerCase();const opts=Array.from(s.options);const opt=opts.find(o=>o.text.trim().toLowerCase()===q||o.value.toLowerCase()===q)||opts.find(o=>o.text.toLowerCase().includes(q));if(!opt)return JSON.stringify({error:'Option not found',option:needle});s.value=opt.value;s.dispatchEvent(new Event('input',{bubbles:true}));s.dispatchEvent(new Event('change',{bubbles:true}));return JSON.stringify({selected:true,value:opt.value,text:opt.text})})()"
}

cmd_submit() {
    local selector_q
    selector_q=$(json_quote "${1:?Usage: web submit <form-selector>}")
    run_action_js "(()=>{const selector=$selector_q;const f=document.querySelector(selector);if(!f)return JSON.stringify({error:'Form not found',selector});if(typeof f.requestSubmit==='function')f.requestSubmit();else f.submit();return JSON.stringify({submitted:true})})()"
}

cmd_scroll() {
    local pixels="${1:?Usage: web scroll <pixels>}"
    [[ "$pixels" =~ ^-?[0-9]+$ ]] || { echo "Error: pixels must be an integer" >&2; exit 1; }
    run_js "(()=>{window.scrollBy(0,$pixels);return JSON.stringify({scrolled:true,at:Math.round(window.scrollY)})})()"
}

cmd_run() {
    [[ $# -gt 0 ]] || { echo "Usage: web run <js>" >&2; exit 1; }
    run_js "$*"
}

cmd_run_main() {
    [[ $# -gt 0 ]] || { echo "Usage: web run-main <js>" >&2; exit 1; }
    run_main_js "$*"
}

cmd_wait() {
    local ms="${1:?Usage: web wait <milliseconds>}"
    [[ "$ms" =~ ^[0-9]+$ ]] || { echo "Error: milliseconds must be an integer" >&2; exit 1; }
    local step=500 elapsed=0 result
    # Readiness wait: return immediately when readyState is already complete.
    result=$(run_js "JSON.stringify({ready:document.readyState==='complete',state:document.readyState,url:location.href,title:document.title,ms:0})")
    if printf '%s' "$result" | grep -q '"ready":true'; then
        printf '%s\n' "$result"
        return 0
    fi
    while (( elapsed < ms )); do
        sleep 0.5 2>/dev/null || sleep 1
        (( elapsed += step )) || true
        result=$(run_js "JSON.stringify({ready:document.readyState==='complete',state:document.readyState,url:location.href,title:document.title,ms:$elapsed})")
        if printf '%s' "$result" | grep -q '"ready":true'; then
            printf '%s\n' "$result"
            return 0
        fi
    done
    printf '%s\n' "$result"
}

cmd_sleep() {
    local ms="${1:?Usage: web sleep <milliseconds>}"
    [[ "$ms" =~ ^[0-9]+$ ]] || { echo "Error: milliseconds must be an integer" >&2; exit 1; }
    local seconds=$((ms / 1000)) millis=$((ms % 1000))
    sleep "${seconds}.$(printf '%03d' "$millis")"
    run_js "JSON.stringify({slept:$ms,state:document.readyState,url:location.href,title:document.title})"
}

cmd_cart() {
    run_js "(()=>{try{var x=new XMLHttpRequest();x.open('GET','/cart.js',false);x.send();var c=JSON.parse(x.responseText);return JSON.stringify({item_count:c.item_count,total:'$'+(c.total_price/100),items:(c.items||[]).map(i=>({title:i.title,qty:i.quantity,price:'$'+(i.price/100)}))})}catch(e){return JSON.stringify({error:'Not a Shopify site or cart unavailable',message:String(e&&e.message||e)})}})()"
}

