}

NATIVE_PID=""
NATIVE_WID=""
prepare_exact_chrome_target() {
    local record
    record=$(resolve_target_record "$TAB_TARGET") || return 1
    parse_session_record "$record"
}

resolve_native_chrome_window() {
    local driver_json native_record bot_window_id="" prefer_named="false"
    if [[ -f "$WEB_SESSION_FILE" ]]; then
        bot_window_id=$(awk -F= '$1=="CHROME_WINDOW_ID"{print $2; exit}' "$WEB_SESSION_FILE" 2>/dev/null || true)
    fi
    [[ -n "$bot_window_id" && "$SESSION_WINDOW_ID" == "$bot_window_id" ]] && prefer_named="true"
    driver_json=$(cua-driver call list_windows '{"on_screen_only":false}' --compact 2>&1) || {
        printf '%s\n' "$driver_json" >&2
        return 1
    }
    native_record=$(printf '%s' "$driver_json" | python3 -c '
import json, sys
name, bounds, prefer_named, target_title = sys.argv[1], sys.argv[2], sys.argv[3] == "true", sys.argv[4]
x, y, width, height = map(int, bounds.split(","))
data = json.load(sys.stdin)
wins = [w for w in data.get("windows", []) if w.get("app_name") == "Google Chrome" and w.get("pid") and w.get("window_id")]
def same_bounds(w):
    b = w.get("bounds") or {}
    return all(abs(int(b.get(k, -99999)) - v) <= 3 for k, v in (("x",x),("y",y),("width",width),("height",height)))
named = [w for w in wins if w.get("title") == name]
bounded = [w for w in wins if same_bounds(w)]
exact_title = [w for w in wins if w.get("title") == target_title]
if prefer_named:
    matched = named or bounded
else:
    matched = [w for w in exact_title if same_bounds(w)] or exact_title or bounded
if not matched: raise SystemExit(1)
matched.sort(key=lambda w: (bool(w.get("is_on_screen")), w.get("on_current_space") is not False, w.get("z_index", -9999)), reverse=True)
w = matched[0]
print("{}\t{}".format(w["pid"], w["window_id"]))
' "$WEB_SESSION_NAME" "$SESSION_BOUNDS" "$prefer_named" "$SESSION_TITLE") || return 1
    IFS=$'\t' read -r NATIVE_PID NATIVE_WID <<< "$native_record"
    [[ "$NATIVE_PID" =~ ^[0-9]+$ && "$NATIVE_WID" =~ ^[0-9]+$ ]]
}

activate_exact_chrome_tab() {
    osascript - "$SESSION_WINDOW_ID" "$SESSION_TAB_ID" <<'APPLESCRIPT' >/dev/null
on run argv
  set wantedWindow to item 1 of argv
  set wantedTab to item 2 of argv
  tell application "Google Chrome"
    repeat with w in windows
      if (id of w as text) is wantedWindow then
        set tabIndex to 0
        repeat with t in tabs of w
          set tabIndex to tabIndex + 1
          if (id of t as text) is wantedTab then set active tab index of w to tabIndex
        end repeat
        set index of w to 1
      end if
    end repeat
    activate
  end tell
end run
APPLESCRIPT
}

trusted_click_from_js() {
    local geometry_js="$1" geometry parsed x y label payload result rc=0
    geometry=$(run_js "$geometry_js") || return 1
    if ! parsed=$(printf '%s' "$geometry" | python3 -c '
import json, sys
j=json.load(sys.stdin)
if j.get("error"): raise SystemExit(j["error"])
print("{}\t{}\t{}".format(round(float(j["x"])), round(float(j["y"])), str(j.get("text", "")).replace(chr(9), " ")[:120]))
'); then
        printf '%s\n' "$geometry" >&2
        return 1
    fi
    IFS=$'\t' read -r x y label <<< "$parsed"
    [[ "$x" =~ ^-?[0-9]+$ && "$y" =~ ^-?[0-9]+$ ]] || { echo "Error: invalid trusted-click coordinates." >&2; return 1; }
    prepare_exact_chrome_target || return 1
    capture_ui_context
    activate_exact_chrome_tab
    sleep 0.2
    if ! resolve_native_chrome_window; then restore_ui_context; return 1; fi
    payload=$(printf '{"pid":%s,"window_id":%s,"x":%s,"y":%s,"count":1}' "$NATIVE_PID" "$NATIVE_WID" "$x" "$y")
    if result=$(cua-driver call click "$payload" --compact 2>&1); then rc=0; else rc=$?; fi
    # Keep the exact Chrome window frontmost long enough for user-activation-gated
    # handlers (downloads, file pickers, permission prompts) to consume the click.
    sleep "${WEB_TRUSTED_CLICK_HOLD_SECONDS:-1.0}"
    restore_ui_context
    if (( rc != 0 )); then printf '%s\n' "$result" >&2; return "$rc"; fi
    printf '{"clicked":true,"trusted":true,"x":%s,"y":%s,"text":%s}\n' "$x" "$y" "$(json_quote "$label")"
}

cmd_trusted_click() {
    local selector_q
    selector_q=$(json_quote "${1:?Usage: web trusted-click <selector>}")
    trusted_click_from_js "(()=>{const selector=$selector_q;const e=document.querySelector(selector);if(!e)return JSON.stringify({error:'Element not found',selector});if(e.disabled||e.getAttribute('aria-disabled')==='true')return JSON.stringify({error:'Element is disabled',selector});e.scrollIntoView({block:'center',inline:'center'});const r=e.getBoundingClientRect(),d=devicePixelRatio||1,ox=Math.max(0,(outerWidth-innerWidth)/2),oy=Math.max(0,outerHeight-innerHeight);return JSON.stringify({x:(ox+r.left+r.width/2)*d,y:(oy+r.top+r.height/2)*d,text:(e.innerText||e.value||e.getAttribute('aria-label')||'').trim()})})()"
}

cmd_trusted_click_text() {
    local text_q selector_q
    text_q=$(json_quote "${1:?Usage: web trusted-click-text <text>}")
    selector_q=$(json_quote "${2:-a,button,input,select,textarea,[role],label,[onclick]}")
    trusted_click_from_js "(()=>{const needle=$text_q,selector=$selector_q;const visible=e=>!!(e.offsetWidth||e.offsetHeight||e.getClientRects().length),txt=e=>(e.innerText||e.value||e.getAttribute('aria-label')||e.title||e.placeholder||''),norm=s=>String(s||'').replace(/\\s+/g,' ').trim().toLowerCase(),q=norm(needle),interactive=e=>/^(A|BUTTON|INPUT|SELECT|TEXTAREA|MAT-OPTION)$/.test(e.tagName)||['button','option','menuitem','radio','checkbox','link','tab'].includes(e.getAttribute('role')),depth=e=>{let d=0;for(let n=e;n;n=n.parentElement)d++;return d};const found=Array.from(document.querySelectorAll(selector)).filter(e=>visible(e)&&norm(txt(e)).includes(q)).map((e,order)=>{const n=norm(txt(e));return{e,order,score:(n===q?100000:n.startsWith(q)?50000:10000)+(interactive(e)?2000:0)+depth(e)*5-Math.min(n.length,1000)}}).sort((a,b)=>b.score-a.score||a.order-b.order)[0]?.e;if(!found)return JSON.stringify({error:'No element found with text',text:needle});if(found.disabled||found.getAttribute('aria-disabled')==='true')return JSON.stringify({error:'Element is disabled',text:needle});found.scrollIntoView({block:'center',inline:'center'});const r=found.getBoundingClientRect(),d=devicePixelRatio||1,ox=Math.max(0,(outerWidth-innerWidth)/2),oy=Math.max(0,outerHeight-innerHeight);return JSON.stringify({x:(ox+r.left+r.width/2)*d,y:(oy+r.top+r.height/2)*d,text:txt(found).trim()})})()"
}

cmd_press() {
    local key="${1:?Usage: web press <key> [modifier,modifier]}" modifier_csv="${2:-}" payload result rc=0
    prepare_exact_chrome_target || return 1
    capture_ui_context
    activate_exact_chrome_tab
    sleep 0.15
    if ! resolve_native_chrome_window; then restore_ui_context; return 1; fi
    payload=$(python3 -c 'import json,sys; print(json.dumps({"pid":int(sys.argv[1]),"window_id":int(sys.argv[2]),"key":sys.argv[3],"modifiers":[x for x in sys.argv[4].split(",") if x]}))' "$NATIVE_PID" "$NATIVE_WID" "$key" "$modifier_csv")
    if result=$(cua-driver call press_key "$payload" --compact 2>&1); then rc=0; else rc=$?; fi
    sleep 0.25
    restore_ui_context
    if (( rc != 0 )); then printf '%s\n' "$result" >&2; return "$rc"; fi
    printf '{"pressed":true,"trusted":true,"key":%s,"modifiers":%s}\n' "$(json_quote "$key")" "$(python3 -c 'import json,sys; print(json.dumps([x for x in sys.argv[1].split(",") if x]))' "$modifier_csv")"
}

cmd_type() {
    local selector="${1:?Usage: web type <selector> <value> [return|tab|escape]}"
    local value="${2:?Usage: web type <selector> <value> [return|tab|escape]}"
    local commit_key="${3:-}" selector_q geometry parsed x y label payload result rc=0
    commit_key=$(printf '%s' "$commit_key" | tr '[:upper:]' '[:lower:]')
    case "$commit_key" in
        ""|none|return|enter|tab|escape|esc) ;;
        *) echo "Error: web type commit key must be return, tab, escape, or omitted." >&2; return 1 ;;
    esac

    selector_q=$(json_quote "$selector")
    geometry=$(run_js "(()=>{const selector=$selector_q;const e=document.querySelector(selector);if(!e)return JSON.stringify({error:'Element not found',selector});if(e.disabled||e.getAttribute('aria-disabled')==='true')return JSON.stringify({error:'Element is disabled',selector});e.scrollIntoView({block:'center',inline:'center'});const r=e.getBoundingClientRect(),d=devicePixelRatio||1,ox=Math.max(0,(outerWidth-innerWidth)/2),oy=Math.max(0,outerHeight-innerHeight);return JSON.stringify({x:(ox+r.left+r.width/2)*d,y:(oy+r.top+r.height/2)*d,text:(e.innerText||e.value||e.getAttribute('aria-label')||'').trim()})})()") || return 1
    if ! parsed=$(printf '%s' "$geometry" | python3 -c '
import json, sys
j=json.load(sys.stdin)
if j.get("error"): raise SystemExit(j["error"])
print("{}\t{}\t{}".format(round(float(j["x"])), round(float(j["y"])), str(j.get("text", "")).replace(chr(9), " ")[:120]))
'); then
        printf '%s\n' "$geometry" >&2
        return 1
    fi
    IFS=$'\t' read -r x y label <<< "$parsed"
    [[ "$x" =~ ^-?[0-9]+$ && "$y" =~ ^-?[0-9]+$ ]] || { echo "Error: invalid type coordinates." >&2; return 1; }

    prepare_exact_chrome_target || return 1
    capture_ui_context
    activate_exact_chrome_tab
    sleep 0.15
    if ! resolve_native_chrome_window; then restore_ui_context; return 1; fi
    payload=$(printf '{"pid":%s,"window_id":%s,"x":%s,"y":%s,"count":1}' "$NATIVE_PID" "$NATIVE_WID" "$x" "$y")
    if result=$(cua-driver call click "$payload" --compact 2>&1); then rc=0; else rc=$?; fi
    if (( rc != 0 )); then restore_ui_context; printf '%s\n' "$result" >&2; return "$rc"; fi
    # Let Chrome deliver the click/focus transition before sending characters.
    sleep "${WEB_TRUSTED_TYPE_FOCUS_SECONDS:-0.8}"

    if result=$(osascript - "$value" "$commit_key" <<'APPLESCRIPT'
on run argv
  set payload to item 1 of argv
  set commitKey to item 2 of argv
  tell application "System Events"
    keystroke "a" using command down
    delay 0.03
    keystroke payload
    delay 0.03
    if commitKey is "return" or commitKey is "enter" then
      key code 36
    else if commitKey is "tab" then
      key code 48
    else if commitKey is "escape" or commitKey is "esc" then
      key code 53
    end if
  end tell
end run
APPLESCRIPT
); then rc=0; else rc=$?; fi
    sleep 0.25
    restore_ui_context
    if (( rc != 0 )); then printf '%s\n' "$result" >&2; return "$rc"; fi
    printf '{"typed":true,"trusted":true,"selector":%s,"characters":%s,"commitKey":%s}\n' "$(json_quote "$selector")" "${#value}" "$(json_quote "$commit_key")"
}

# --- Chrome tabs via AppleScript ---

cmd_tabs() {
    ensure_session
    osascript - "$SESSION_WINDOW_ID" "$SESSION_TAB_ID" <<'APPLESCRIPT'
on run argv
  set sessionWindowId to item 1 of argv
  set sessionTabId to item 2 of argv
  set output to "target" & (ASCII character 9) & "window_id" & (ASCII character 9) & "tab_id" & (ASCII character 9) & "title" & (ASCII character 9) & "url" & (ASCII character 9) & "markers" & linefeed
  set d to ASCII character 9
  tell application "Google Chrome"
    set windowIndex to 0
    repeat with w in windows
      set windowIndex to windowIndex + 1
      set activeId to id of active tab of w as text
      set tabIndex to 0
      repeat with t in tabs of w
        set tabIndex to tabIndex + 1
        set marker to ""
        if (id of t as text) is activeId then set marker to "active"
        if (id of w as text) is sessionWindowId then
          if marker is not "" then set marker to marker & ","
          set marker to marker & "bot-window"
        end if
        if (id of t as text) is sessionTabId then
          if marker is not "" then set marker to marker & ","
          set marker to marker & "bot-session"
        end if
        set output to output & windowIndex & "." & tabIndex & d & (id of w as text) & d & (id of t as text) & d & title of t & d & URL of t & d & marker & linefeed
      end repeat
    end repeat
  end tell
  return output
end run
APPLESCRIPT
}

cmd_switch() {
    local target="${1:?Usage: web switch <index|url|title|tab:ID>}" result
    [[ "$target" == tab:* ]] && target="${target#tab:}"
    ensure_session
    capture_ui_context
    result=$(osascript - "$SESSION_WINDOW_ID" "$target" <<'APPLESCRIPT'
on run argv
  set wantedWindow to item 1 of argv
  set needle to item 2 of argv
  tell application "Google Chrome"
    set targetWindow to missing value
    repeat with w in windows
      if (id of w as text) is wantedWindow then set targetWindow to w
    end repeat
    if targetWindow is missing value then return "0"
    try
      set tabIndex to needle as integer
      if tabIndex ≥ 1 and tabIndex ≤ (count of tabs of targetWindow) then
        set active tab index of targetWindow to tabIndex
        return id of tab tabIndex of targetWindow as text
      end if
    end try
    set tabIndex to 0
    repeat with t in tabs of targetWindow
      set tabIndex to tabIndex + 1
      if URL of t contains needle or title of t contains needle or (id of t as text) is needle then
        set active tab index of targetWindow to tabIndex
        return id of t as text
      end if
    end repeat
    return "0"
  end tell
end run
APPLESCRIPT
)
    restore_ui_context
    if [[ "$result" == "0" ]]; then
        echo "No Pi Automation tab found matching: $target" >&2
        return 1
    fi
    SESSION_TAB_ID="$result"
    save_session
    echo "Switched Pi Automation to tab id $result"
}

cmd_newtab() {
    local url="${1:?Usage: web newtab <url>}" result
    ensure_session
    capture_ui_context
    result=$(osascript - "$SESSION_WINDOW_ID" "$url" <<'APPLESCRIPT'
on run argv
  set wantedWindow to item 1 of argv
  set targetUrl to item 2 of argv
  tell application "Google Chrome"
    repeat with w in windows
      if (id of w as text) is wantedWindow then
        set newTab to make new tab at end of tabs of w with properties {URL:targetUrl}
        set active tab index of w to count of tabs of w
        return id of newTab as text
      end if
    end repeat
  end tell
  error "Pi Automation window not found"
end run
APPLESCRIPT
)
    SESSION_TAB_ID="$result"
    save_session
    restore_ui_context
    echo "Opened Pi Automation tab id $result: $url"
}

cmd_closetab() {
    local target="${1:?Usage: web closetab <index|url|title|tab:ID>}" result closed_id remaining_id
    [[ "$target" == tab:* ]] && target="${target#tab:}"
    ensure_session
    capture_ui_context
    result=$(osascript - "$SESSION_WINDOW_ID" "$target" <<'APPLESCRIPT'
on run argv
  set wantedWindow to item 1 of argv
  set needle to item 2 of argv
  set d to ASCII character 9
  tell application "Google Chrome"
    set targetWindow to missing value
    repeat with w in windows
      if (id of w as text) is wantedWindow then set targetWindow to w
    end repeat
    if targetWindow is missing value then return "0"
    set targetTab to missing value
    try
      set tabIndex to needle as integer
      if tabIndex ≥ 1 and tabIndex ≤ (count of tabs of targetWindow) then set targetTab to tab tabIndex of targetWindow
    end try
    if targetTab is missing value then
      repeat with t in tabs of targetWindow
        if URL of t contains needle or title of t contains needle or (id of t as text) is needle then
          set targetTab to t
          exit repeat
        end if
      end repeat
    end if
    if targetTab is missing value then return "0"
    set closedId to id of targetTab as text
    close targetTab
    delay 0.05
    return closedId & d & (id of active tab of targetWindow as text)
  end tell
end run
APPLESCRIPT
)
    restore_ui_context
    if [[ "$result" == "0" ]]; then
        echo "No Pi Automation tab found matching: $target" >&2
        return 1
    fi
    IFS=$'\t' read -r closed_id remaining_id <<< "$result"
    if [[ "$SESSION_TAB_ID" == "$closed_id" ]]; then SESSION_TAB_ID="$remaining_id"; fi
    save_session
    echo "Closed Pi Automation tab id $closed_id"
}

resolve_target_record() {
    local target="$1"
    osascript - "$target" "$WEB_SESSION_NAME" <<'APPLESCRIPT'
on run argv
  set needle to item 1 of argv
  set sessionName to item 2 of argv
  set d to ASCII character 9
  tell application "Google Chrome"
    set targetWindow to missing value
    set targetTab to missing value
    set sessionWindow to missing value
    repeat with w in windows
      try
        if (given name of w as text) is sessionName then set sessionWindow to w
      end try
    end repeat
    if needle is "session" or needle is "bot" then
      if sessionWindow is not missing value then
        set targetWindow to sessionWindow
        set targetTab to active tab of sessionWindow
      end if
    else if needle is "active" or needle is "__active__" then
      if (count of windows) > 0 then
        set targetWindow to window 1
        set targetTab to active tab of window 1
      end if
    else if needle starts with "tab:" then
      set wantedId to text 5 thru -1 of needle
      repeat with w in windows
        repeat with t in tabs of w
          if (id of t as text) is wantedId then
            set targetWindow to w
            set targetTab to t
            exit repeat
          end if
        end repeat
        if targetTab is not missing value then exit repeat
      end repeat
    else
      if sessionWindow is not missing value then
        repeat with t in tabs of sessionWindow
          if URL of t contains needle or title of t contains needle or (id of t as text) is needle then
            set targetWindow to sessionWindow
            set targetTab to t
            exit repeat
          end if
        end repeat
      end if
      if targetTab is missing value then
        repeat with w in windows
          repeat with t in tabs of w
            if URL of t contains needle or title of t contains needle or (id of t as text) is needle then
              set targetWindow to w
              set targetTab to t
              exit repeat
            end if
          end repeat
          if targetTab is not missing value then exit repeat
        end repeat
      end if
    end if
    if targetTab is missing value then error "No Chrome tab matches: " & needle
    set b to bounds of targetWindow
    return (id of targetWindow as text) & d & (id of targetTab as text) & d & (item 1 of b as text) & d & (item 2 of b as text) & d & (item 3 of b as text) & d & (item 4 of b as text) & d & (title of targetTab as text) & d & (URL of targetTab as text)
  end tell
end run
APPLESCRIPT
}

cmd_resolve() {
    local target="${1:-session}" record
    if [[ "$target" == "session" || "$target" == "bot" ]]; then
        ensure_session
    else
        record=$(resolve_target_record "$target")
        parse_session_record "$record"
    fi
    printf '{"windowId":%s,"tabId":%s,"target":"tab:%s","bounds":%s,"title":%s,"url":%s}\n' \
        "$SESSION_WINDOW_ID" "$SESSION_TAB_ID" "$SESSION_TAB_ID" "$(json_quote "$SESSION_BOUNDS")" \
        "$(json_quote "$SESSION_TITLE")" "$(json_quote "$SESSION_URL")"
}

cmd_bind() {
    local target="${1:-active}" record old_window
    load_session
    old_window="$SESSION_WINDOW_ID"
    record=$(resolve_target_record "$target")
    parse_session_record "$record"
    osascript - "$old_window" "$SESSION_WINDOW_ID" "$WEB_SESSION_NAME" <<'APPLESCRIPT'
on run argv
  set oldId to item 1 of argv
  set newId to item 2 of argv
  set sessionName to item 3 of argv
  tell application "Google Chrome"
    repeat with w in windows
      if (id of w as text) is oldId and oldId is not newId then
        try
          set given name of w to ""
        end try
      end if
      if (id of w as text) is newId then set given name of w to sessionName
    end repeat
  end tell
end run
APPLESCRIPT
    save_session
    cmd_session
}

show_help() {
    cat <<'HELP'
web — fast live-Chrome browser interaction via cua-driver

SESSION:
  web session                   # Persistent Pi Automation window/tab
  web bind [active|url|title]   # Intentionally move the bot session to a chosen tab
  web --tab <active|N|url|title|tab:ID> ... # Explicit one-call target override

NAVIGATION:
  web nav <url>                 # Go to URL in active tab
  web url / title               # Current URL / title
  web wait <ms>                 # Readiness wait; returns immediately if complete
  web sleep <ms>                # Always pause for the requested duration

READING:
  web summary                   # Title, headings, buttons, links, forms
  web text                      # Full visible page text
  web find <selector>           # Elements by CSS selector
  web find-text <text> [tags]   # Elements by text
  web find-links [text]         # Links, optionally filtered by text
  web find-buttons [text]       # Buttons, optionally filtered by text
  web find-inputs               # Form inputs
  web exists <selector>         # Does element exist?
  web value <selector>          # Read element value/text

ACTIONS:
  web click <selector>          # Fast synthetic DOM click by CSS selector
  web click-text <text> [tags]  # Fast synthetic DOM click by ranked visible text
  web trusted-click <selector>  # Real foreground click for downloads/pickers/permissions
  web trusted-click-text <text> [tags] # Real foreground click by ranked visible text
  web press <key> [mods]        # Real key press; mods are comma-separated
  web fill <selector> <value>   # Fast background fill + synthetic framework events
  web type <selector> <value> [return|tab|escape] # Real typing for controls that reject fill
  web select <selector> <text>  # Select dropdown option by text/value
  web submit <form>             # Submit form
  web scroll <pixels>           # Scroll (positive down, negative up)

TABS (AppleScript, no pid/wid needed):
  web tabs                      # List every Chrome window/tab and bot markers
  web switch <N|url|title>      # Switch inside the Pi Automation window
  web newtab <url>              # Open a tab in Pi Automation and remember it
  web closetab <N|url|title>    # Close a Pi Automation tab

ADVANCED:
  web run <js>                  # Run synchronous JS in the automation DOM world
  web run-main <js>             # Run synchronous JS with page-owned framework state
  web cart                      # Shopify cart contents

IMPORTANT:
  - With no --tab, commands stay on the persistent, named Pi Automation window/tab across turns.
  - --tab active is an explicit opt-in to the user's currently active Chrome tab.
  - Pi Automation is a second window in the same normal Chrome process/profile—not a second login session.
  - --tab targets any Chrome tab in the background through Apple Events; the user can keep working elsewhere.
  - switch/newtab do not activate Chrome or steal focus.
  - Use this instead of AX tree for web content.
  - For async-like page/network work inside JS, use synchronous XMLHttpRequest.
  - Synthetic click is fastest; trusted-click temporarily fronts the exact target and restores focus.
  - Tab commands use AppleScript; trusted input uses Cua; normal page commands use DOM JavaScript.
HELP
}

# --- Main ---
cmd="${1:-help}"
shift || true

case "$cmd" in help|--help|-h) ;; *) acquire_session_lock ;; esac

case "$cmd" in
    auto)         cmd_auto ;;
    session)      cmd_session ;;
    resolve)      cmd_resolve "${1:-session}" ;;
    bind)         cmd_bind "${1:-active}" ;;
    tabs)         cmd_tabs ;;
    switch)       cmd_switch "${1:?Usage: web switch <index|url|title>}" ;;
    newtab)       cmd_newtab "${1:?Usage: web newtab <url>}" ;;
    closetab)     cmd_closetab "${1:?Usage: web closetab <index|url|title>}" ;;
    nav)          ensure_target; cmd_nav "${1:?Usage: web nav <url>}" ;;
    summary)      ensure_target; cmd_summary ;;
    text)         ensure_target; cmd_text ;;
    url)          ensure_target; cmd_url ;;
    title)        ensure_target; cmd_title ;;
    find)         ensure_target; cmd_find "${1:?Usage: web find <selector>}" ;;
    find-text)    ensure_target; cmd_find_text "${1:?Usage: web find-text <text>}" "${2:-}" ;;
    find-links)   ensure_target; cmd_find_links "${1:-}" ;;
    find-buttons) ensure_target; cmd_find_buttons "${1:-}" ;;
    find-inputs)  ensure_target; cmd_find_inputs ;;
    click)        ensure_target; cmd_click "${1:?Usage: web click <selector>}" ;;
    click-text)   ensure_target; cmd_click_text "${1:?Usage: web click-text <text>}" "${2:-}" ;;
    trusted-click) ensure_target; cmd_trusted_click "${1:?Usage: web trusted-click <selector>}" ;;
    trusted-click-text) ensure_target; cmd_trusted_click_text "${1:?Usage: web trusted-click-text <text>}" "${2:-}" ;;
    press)        ensure_target; cmd_press "${1:?Usage: web press <key> [modifier,modifier]}" "${2:-}" ;;
    fill)         ensure_target; cmd_fill "${1:?Usage: web fill <selector> <value>}" "${2:?Usage: web fill <selector> <value>}" ;;
    type)         ensure_target; cmd_type "${1:?Usage: web type <selector> <value> [return|tab|escape]}" "${2:?Usage: web type <selector> <value> [return|tab|escape]}" "${3:-}" ;;
    select)       ensure_target; cmd_select "${1:?Usage: web select <selector> <option-text>}" "${2:?Usage: web select <selector> <option-text>}" ;;
    submit)       ensure_target; cmd_submit "${1:?Usage: web submit <form-selector>}" ;;
    scroll)       ensure_target; cmd_scroll "${1:?Usage: web scroll <pixels>}" ;;
    run)          ensure_target; cmd_run "$@" ;;
    run-main)     ensure_target; cmd_run_main "$@" ;;
    wait)         ensure_target; cmd_wait "${1:?Usage: web wait <milliseconds>}" ;;
    sleep)        ensure_target; cmd_sleep "${1:?Usage: web sleep <milliseconds>}" ;;
    cart)         ensure_target; cmd_cart ;;
    exists)       ensure_target; cmd_exists "${1:?Usage: web exists <selector>}" ;;
    value)        ensure_target; cmd_value "${1:?Usage: web value <selector>}" ;;
    help|--help|-h) show_help ;;
    *)
        echo "Unknown command: $cmd. Run 'web help'." >&2
        exit 1
        ;;
esac
