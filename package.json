{
  "name": "littlecua",
  "version": "1.3.0",
  "description": "LittleCua — MCP-native macOS and authenticated Chrome automation for Pi, with batched workflows and a repair-first/no-replay contract.",
  "keywords": ["pi-package"],
  "scripts": {
    "test": "node scripts/test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "generate:dom": "node extensions/web-cli/generate-dom-templates.mjs",
    "test:mcp-live": "node extensions/cua-tool/tests/native-mcp-live.mjs",
    "test:web-live": "node extensions/web-cli/tests/native-web-live.mjs",
    "test:readiness-live": "node extensions/web-cli/tests/readiness-focus-live.mjs",
    "test:live": "node extensions/cua-tool/tests/visual-live.mjs",
    "test:fixture": "node extensions/cua-tool/tests/native-fixture.e2e.mjs",
    "test:business": "node extensions/cua-tool/tests/business-fixture.e2e.mjs",
    "test:business-inform": "node extensions/cua-tool/tests/business-workflow-informed.mjs"
  },
  "engines": { "node": ">=22.19.0" },
  "license": "MIT",
  "author": "MaxAutomize",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaxAutomize/LittleCua.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "extensions/cua-tool/index.ts",
      "extensions/web-cli/index.ts"
    ]
  }
}